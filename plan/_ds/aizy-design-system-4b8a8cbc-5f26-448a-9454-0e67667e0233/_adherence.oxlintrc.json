{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/app/**",
              "components/content/**",
              "components/core/**",
              "components/data/**",
              "components/slide/**",
              "ui_kits/platform/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans|Plus Jakarta Sans Static))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans, Plus Jakarta Sans Static."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|width|style|key|ref|className|style|children)$/]",
        "message": "<AccentRule> doesn't accept that prop. Declared props: tone, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentRule'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:purple|mint|white)$/]",
        "message": "<AccentRule> tone must be one of 'purple' | 'mint' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentExchange'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|children|style|key|ref|className|style|children)$/]",
        "message": "<AgentExchange> doesn't accept that prop. Declared props: question, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|actions|sidebar|height|children|style|key|ref|className|style|children)$/]",
        "message": "<AppFrame> doesn't accept that prop. Declared props: title, subtitle, actions, sidebar, height, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:positive|pending|negative|neutral|accent|onDark)$/]",
        "message": "<Badge> tone must be one of 'positive' | 'pending' | 'negative' | 'neutral' | 'accent' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|key|ref|className|style|children)$/]",
        "message": "<BulletItem> doesn't accept that prop. Declared props: title, description."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|iconLeft|iconRight|fullWidth|as|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, iconLeft, iconRight, fullWidth, as, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|gradient|secondary|ghost|onDark|mint)$/]",
        "message": "<Button> variant must be one of 'primary' | 'gradient' | 'secondary' | 'ghost' | 'onDark' | 'mint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
