      {
        "selector": "JSXOpeningElement[name.name='CalloutBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|variant|highlight|children|style|key|ref|className|style|children)$/]",
        "message": "<CalloutBar> doesn't accept that prop. Declared props: label, variant, highlight, children, style."
